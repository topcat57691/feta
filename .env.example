# Leave these unset for device-local mode.
# Set all three to make the wall display and parent phones share one household state.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Generate a long random UUID/secret and use the same value on every family device/deployment.
EXPO_PUBLIC_FETA_HOUSEHOLD_ID=CHANGE_ME_TO_A_RANDOM_UUID
