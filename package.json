{
  "name": "feta",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && npm run db:migrate && wrangler deploy",
    "db:create": "wrangler d1 create feta",
    "db:migrate": "wrangler d1 migrations apply feta --remote",
    "db:migrate:local": "wrangler d1 migrations apply feta --local",
    "check:worker": "wrangler deploy --dry-run --outdir .wrangler-dry-run"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.10",
    "wrangler": "4.136.1"
  },
  "packageManager": "npm@11.21.2"
}
