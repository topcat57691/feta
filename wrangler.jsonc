{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "feta",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-15",
  "upload_source_maps": true,
  "preview_urls": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "feta",
      "database_id": "188a8e92-7d15-4d52-8168-58c24929dc26",
      "migrations_dir": "db/migrations"
    }
  ],
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["*/15 * * * *"] },
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "feta",
        "database_id": "188a8e92-7d15-4d52-8168-58c24929dc26"
      }
    ]
  }
}
